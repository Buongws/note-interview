# Copy file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local)
# Lấy connection string từ MongoDB Atlas -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interview-note?retryWrites=true&w=majority"

# (Khuyến nghị cho production) Chuỗi ngẫu nhiên dài để ký cookie đăng nhập: openssl rand -hex 32
SESSION_SECRET=""
